{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["app.js", "js/**/*.js", "components/**/*.js", "build.mjs"],
  "exclude": ["node_modules", "dist", "coverage", "playwright-report", "test-results", "tests"]
}
